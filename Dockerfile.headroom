# syntax=docker/dockerfile:1

FROM ghcr.io/headroomlabs-ai/headroom:latest

USER root

# Explicitly create the nonroot user if it doesn't exist
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN groupadd -g ${HOST_GID} nonroot || true && \
    useradd -u ${HOST_UID} -g ${HOST_GID} -m nonroot || true

# Now pip install
RUN python -m pip install --no-cache-dir \
    "torch>=2.12.1" \
    "transformers>=5.5.0,<6.0" \
    "huggingface-hub>=1.5.0,<2.0"

# Now chown safely (user definitely exists)
RUN mkdir -p /headroom-cache && chown nonroot:nonroot /headroom-cache

USER nonroot


