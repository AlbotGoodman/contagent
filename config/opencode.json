{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/{env:OLLAMA_MODEL}",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://ollama:11434/v1"
      },
      "models": {
        "{env:OLLAMA_MODEL}": {
          "name": "{env:OLLAMA_MODEL}"
        }
      }
    }
  }
}