# Copy this to .env and fill in your values

# Ollama Settings
# Model to pull and serve. This is also the model OpenCode selects by default,
# via the {env:OLLAMA_MODEL} placeholders in config/opencode.json.
OLLAMA_MODEL=qwen3-coder:30b

# Context window handed to the model. Keep this equal to limit.context in
# config/opencode.json -- OpenCode trusts that number when deciding how much
# room is left before it compacts, and if the two disagree the agent either
# compacts far too early or overflows the real window.
# Context window for the model. With 24 GB VRAM, 128k is feasible for many models;
# raise/lower based on model size and quantization.
OLLAMA_CONTEXT_LENGTH=131072

# OpenCode Settings
OPENCODE_MODE=agentic

# User settings
# Must match the UID/GID of the files you want the agent to own. Dockerfiles
# cannot read this file directly, so the Makefile passes these to the build as
# --build-arg; changing them requires `make rebuild`.
HOST_UID=1000
HOST_GID=1000
